---
interface Props {
  name: 'pin' | 'phone' | 'fax' | 'mail' | 'clock' | 'linkedin';
  size?: number;
}

const { name, size = 18 } = Astro.props;
const isBrand = name === 'linkedin';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? 'none' : 'currentColor'}
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'pin' && (
    <>
      <path d="M12 21.5s7-5.7 7-11.4a7 7 0 1 0-14 0c0 5.7 7 11.4 7 11.4Z" />
      <circle cx="12" cy="10" r="2.6" />
    </>
  )}
  {name === 'phone' && (
    <path d="M6.2 3.5h3l1.4 4-2 1.5a12.4 12.4 0 0 0 6.4 6.4l1.5-2 4 1.4v3a2 2 0 0 1-2.2 2A17.4 17.4 0 0 1 4.2 5.7a2 2 0 0 1 2-2.2Z" />
  )}
  {name === 'fax' && (
    <>
      <path d="M7 8V3h10v5" />
      <rect x="4" y="8" width="16" height="8" rx="1" />
      <path d="M7 13h10v8H7z" />
      <path d="M17 11h.01" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'linkedin' && (
    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6.5 0H13v1.7h.05c.5-.95 1.7-1.95 3.5-1.95 3.75 0 4.45 2.45 4.45 5.65V21h-4v-5.8c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.52-2.25 3.1V21h-4V9Z" />
  )}
</svg>
